<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Student Dashboard - School ERP</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #222;
    }

    header {
      background: #7c3aed;
      color: white;
      padding: 20px 30px;
    }

    header h1 {
      margin: 0;
      font-size: 24px;
    }

    .container {
      max-width: 1200px;
      margin: 30px auto;
      padding: 0 20px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .card h3 {
      margin-top: 0;
      color: #555;
      font-size: 16px;
    }

    .value {
      font-size: 32px;
      font-weight: bold;
      margin-top: 10px;
    }

    .section {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
      margin-bottom: 25px;
    }

    .section h2 {
      margin-top: 0;
    }

    .student-info {
      line-height: 1.8;
    }

    .course {
      padding: 15px;
      margin-bottom: 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
      background: #fafafa;
    }

    #error {
      color: #b91c1c;
      margin-bottom: 20px;
    }

    @media (max-width: 768px) {
      .cards {
        grid-template-columns: 1fr;
      }
    }
  </style>

</head>

<body data-dashboard-role="student">

  <header>
    <h1>School ERP - Student Dashboard</h1>
  </header>

  <main class="container">

```
<div id="error"></div>

<section class="cards">

  <div class="card">
    <h3>My Attendance</h3>
    <div class="value" id="attendancePercentage">—</div>
  </div>

  <div class="card">
    <h3>Student Information</h3>

    <div
      id="studentInfo"
      class="student-info"
    >
      Loading...
    </div>

  </div>

</section>

<section class="section">

  <h2>My Courses</h2>

  <div id="courseList">
    <p>Loading courses...</p>
  </div>

</section>

<section class="section">

  <h2>Recent Exam Scores</h2>

  <canvas id="examScoreChart"></canvas>

</section>
```

  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script src="/js/dashboards.js"></script>

</body>
</html>
