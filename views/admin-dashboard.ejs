<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Admin Dashboard - School ERP</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #222;
    }

    header {
      background: #1e3a8a;
      color: white;
      padding: 20px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header h1 {
      margin: 0;
      font-size: 24px;
    }

    .container {
      max-width: 1200px;
      margin: 30px auto;
      padding: 0 20px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .card h3 {
      margin-top: 0;
      color: #555;
      font-size: 16px;
    }

    .value {
      font-size: 32px;
      font-weight: bold;
      margin-top: 10px;
    }

    .chart-box {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .chart-box h2 {
      margin-top: 0;
    }

    #error {
      color: #b91c1c;
      margin-bottom: 20px;
    }

    @media (max-width: 768px) {
      .cards {
        grid-template-columns: 1fr;
      }
    }
  </style>

</head>

<body data-dashboard-role="admin">

  <header>
    <h1>School ERP - Admin Dashboard</h1>
  </header>

  <main class="container">

```
<div id="error"></div>

<section class="cards">

  <div class="card">
    <h3>Total Active Students</h3>
    <div class="value" id="totalStudents">—</div>
  </div>

  <div class="card">
    <h3>Average Attendance</h3>
    <div class="value" id="averageAttendance">—</div>
  </div>

  <div class="card">
    <h3>Total Courses</h3>
    <div class="value" id="totalCourses">—</div>
  </div>

</section>

<section class="chart-box">

  <h2>Attendance Overview</h2>

  <canvas id="attendanceChart"></canvas>

</section>
```

  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script src="/js/dashboards.js"></script>

</body>
</html>
